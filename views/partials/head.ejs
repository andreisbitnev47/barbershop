<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta name="description" content="<%= t.metaDesc %>">
<meta name="author" content="Rocca Juuksur">
<meta name="copyrighted-site-verification" content="ddef625ce95bf08d" />

<title><%= t.title %></title>

<!-- Canonical & Language Links -->
<link rel="canonical" href="<%= t.canonical %>">
<link rel="alternate" hreflang="et" href="https://roccajuuksur.ee/" />
<link rel="alternate" hreflang="ru" href="https://roccajuuksur.ee/ru/" />
<link rel="alternate" hreflang="en" href="https://roccajuuksur.ee/en/" />
<link rel="alternate" hreflang="x-default" href="https://roccajuuksur.ee/" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website">
<meta property="og:url" content="<%= t.canonical %>">
<meta property="og:title" content="<%= t.ogTitle %>">
<meta property="og:description" content="<%= t.ogDesc %>">
<meta property="og:image" content="https://roccajuuksur.ee/logos/logo.png">

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image">
<meta property="twitter:url" content="<%= t.canonical %>">
<meta property="twitter:title" content="<%= t.ogTitle %>">
<meta property="twitter:description" content="<%= t.ogDesc %>">
<meta property="twitter:image" content="https://roccajuuksur.ee/logos/logo.png">
<!-- Bootstrap core CSS -->
<link href="<%= baseDir %>vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
<link href='<%= baseDir %>vendor/jquery/jquery-ui.min.css' rel='stylesheet' type='text/css'>
<link href='<%= baseDir %>vendor/jquery/jquery-ui.structure.min.css' rel='stylesheet' type='text/css'>
<link href='<%= baseDir %>vendor/jquery/jquery-ui.theme.min.css' rel='stylesheet' type='text/css'>

<!-- Custom fonts for this template -->
<link href="<%= baseDir %>vendor/font-awesome/css/font-awesome.min.css" rel="stylesheet" type="text/css">
<link href="https://fonts.googleapis.com/css?family=Montserrat:400,700" rel="stylesheet" type="text/css">
<link href='https://fonts.googleapis.com/css?family=Kaushan+Script' rel='stylesheet' type='text/css'>
<link href='https://fonts.googleapis.com/css?family=Droid+Serif:400,700,400italic,700italic' rel='stylesheet' type='text/css'>
<link href='https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700' rel='stylesheet' type='text/css'>

<!-- Custom styles for this template -->
<link href="<%= baseDir %>css/agency.css" rel="stylesheet">
<style>
  .section-heading.text-uppercase { color: #E4B756; }
  .white { color: #fff !important; }
  body { color: #fff; }
  .text-muted { color: #b3b3b3 !important; }
  #services, #portfolio { background-color: black; }
  footer { background-color: black; }
  #timeSelection label, #clientDetails label { color: black; margin-top: 5px; }
  .numberPrefix { color: black; }
  .red { color: red; }
  #selectable .ui-selecting { background: #FECA40; }
  #selectable .ui-selected { background: #F39814; color: white; }
  #selectable { list-style-type: none; margin: 0; padding: 0; width: 60%; }
  #selectable li { margin: 3px; padding: 0.4em; font-size: 1.4em; height: 18px; }
</style>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BarberShop",
  "name": "Rocca Juuksur",
  "image": "https://roccajuuksur.ee/logos/logo.png",
  "@id": "<%= t.canonical %>",
  "url": "<%= t.canonical %>",
  "telephone": "+372 55529783",
  "priceRange": "$$",
  "sameAs": [
    "https://www.facebook.com/nella.sbitneva",
    "http://astangu-juuksur.business.site/"
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Päevalille tn 4",
    "addressLocality": "Tallinn",
    "postalCode": "13517",
    "addressCountry": "EE"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "10:00",
      "closes": "19:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Saturday",
      "opens": "10:00",
      "closes": "16:00"
    }
  ],
  "description": "<%= t.schemaDesc %>",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Haircut Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "<%= t.services.clipper.name %>"
        },
        "price": "25.00",
        "priceCurrency": "EUR"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "<%= t.services.scissor.name %>"
        },
        "price": "28.00",
        "priceCurrency": "EUR"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "<%= t.services.beard.name %>"
        },
        "price": "18.00",
        "priceCurrency": "EUR"
      }
    ]
  }
}
</script>
