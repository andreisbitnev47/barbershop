<!-- Bootstrap core JavaScript -->
<script src="<%= baseDir %>vendor/jquery/jquery.min.js"></script>
<script src="<%= baseDir %>vendor/jquery/jquery-ui.min.js"></script>
<% if(lang === 'est') { %><script src="<%= baseDir %>vendor/jquery/datepicker-et.js"></script><% } %>
<% if(lang === 'ru') { %><script src="<%= baseDir %>vendor/jquery/datepicker-ru.js"></script><% } %>
<!-- EN usually uses default so we don't necessarily load a specific one for EN here, or rely on defaults -->

<script src="<%= baseDir %>vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

<!-- Plugin JavaScript -->
