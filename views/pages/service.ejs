<!DOCTYPE html>
<html lang="<%= t.langCode %>">

<head>
<%- include('../partials/head') %>
<meta name="robots" content="index, follow">
<title><%= service.title %></title>
</head>

<body id="page-top">
<%- include('../partials/nav') %>

<header class="masthead" style="height: 60vh; min-height: 400px; padding-top: 150px;">
  <div class="container">
    <div class="intro-text" style="padding-top: 50px;">
      <h1 class="intro-lead-in"><span class=""><%= service.title %></span></h1>
      <a class="btn btn-primary btn-xl text-uppercase js-scroll-trigger" href="/<%= t.dirPrefix %>#book">
        <span class=""><%= t.header.btn %></span>
      </a>
    </div>
  </div>
</header>

<section id="service-details" style="background-color: black; padding: 100px 0;">
  <div class="container">
    <div class="row">
      <div class="col-lg-12 text-center">
        <h2 class="section-heading text-uppercase"><span class=""><%= service.serviceTitle %></span></h2>
      </div>
    </div>
    <div class="row mt-5" style="color: white; font-size: 1.2rem; line-height: 1.8;">
      <div class="col-md-8 mx-auto text-center text-muted">
        <p><%= service.article %></p>
        <br>
        <p><%= t.hours.locationDesc %></p>
        <br>
        <a class="btn btn-outline-warning btn-xl text-uppercase" href="/<%= t.dirPrefix %>#services">
          <span class="">&larr; <%= t.nav.pricing %></span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Include map directly here so it isn't lost -->
<section id="map">
</section>

<!-- Map Image Modal -->
<div id="mapImageModal" style="display: none; position: fixed; z-index: 10000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.8); cursor: pointer;">
  <span id="closeMapModal" style="position: absolute; top: 15px; right: 35px; color: white; font-size: 40px; cursor: pointer; z-index: 10001;">&times;</span>
  <img id="mapModalImage" style="margin: auto; display: block; max-width: 90%; max-height: 90%; margin-top: 5%; cursor: default;">
  <div id="mapModalCaption" style="text-align: center; color: white; padding: 10px; font-size: 16px;"></div>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>

</body>
</html>
